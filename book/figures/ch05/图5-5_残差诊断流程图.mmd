    classDef orange fill:#F8982E,color:#FFFFFF,stroke:#F8982E,stroke-width:1.5px;
    classDef gray fill:#8C8C8C,color:#FFFFFF,stroke:#8C8C8C,stroke-width:1.5px;
    class R,OK,C1,C2 navy;
    class C3,FIX orange;
    class Q,NOTE,CASE gray;
